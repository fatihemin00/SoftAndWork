@model IEnumerable<SoftAndWork.Models.Course>
@{
    ViewData["Title"] = "Derslerim";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color: #4a148c; font-weight: 700;"><i class="bi bi-journal-bookmark-fill"></i> Derslerim</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm"><i class="bi bi-check-circle"></i> @TempData["Success"]</div>
    }

    <div class="card shadow-sm border-0 mb-5 p-3" style="background-color: #fdfdfd;">
        <form asp-action="Create" method="post" class="d-flex gap-2">
            <input type="text" name="title" class="form-control form-control-lg" placeholder="Yeni Ders Adı (Örn: Tarih, Türk Dili)" required />
            <button type="submit" class="btn btn-success btn-lg px-4" style="background-color: #2e7d32; border:none; font-weight: 600;"><i class="bi bi-plus-lg"></i> Oluştur</button>
        </form>
    </div>

    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center text-muted mt-5">
                <i class="bi bi-folder-x display-1 opacity-25"></i>
                <p class="mt-3 fs-5">Henüz hiç ders eklemediniz. Yukarıdan ilk dersinizi oluşturun!</p>
            </div>
        }
        @foreach (var course in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0" style="background-color: #ffffff; border-radius: 12px; transition: transform 0.2s;">
                    <div class="card-body p-4 d-flex flex-column">
                        <h4 class="card-title fw-bold mb-3" style="color: #333;">@course.Title</h4>
                        <p class="text-muted small mb-4"><i class="bi bi-file-earmark-text"></i> Toplam @course.Materials.Count materyal yüklendi.</p>

                        <div class="mt-auto d-flex justify-content-between gap-2">
                            <a asp-action="Details" asp-route-id="@course.Id" class="btn flex-grow-1 text-white fw-bold shadow-sm" style="background-color: #4a148c;">
                                <i class="bi bi-box-arrow-in-right"></i> Derse Git
                            </a>

                            <!-- SİLME BUTONU BURADA -->
                            <form asp-action="DeleteCourse" method="post" class="m-0" onsubmit="return confirm('Bu dersi ve içindeki tüm materyalleri/soruları silmek istediğinize emin misiniz? Bu işlem geri alınamaz!');">
                                <input type="hidden" name="id" value="@course.Id" />
                                <button type="submit" class="btn btn-outline-danger shadow-sm" title="Dersi Sil">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>